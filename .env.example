# Copia questo file in ".env" e riempi i valori reali.
# ".env" non va mai committato (è già in .gitignore).

# API key Anthropic (Claude)
ANTHROPIC_API_KEY=

# Percorso assoluto del vault Obsidian usato come knowledge base
OBSIDIAN_VAULT_PATH=C:\Users\tomma\projects\Personal Assistant\Personal Assistant

# Google OAuth (Fase 2 - Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Orario di invio del digest mattutino proattivo, formato HH:MM, fuso Europe/Rome (Fase 5)
MORNING_DIGEST_TIME=07:30
