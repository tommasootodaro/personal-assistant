# Copia questo file in ".env" e riempi i valori reali.
# ".env" non va mai committato (è già in .gitignore).

# API key Anthropic (Claude)
ANTHROPIC_API_KEY=

# Percorso assoluto del vault Obsidian usato come knowledge base
OBSIDIAN_VAULT_PATH=C:\Users\<tuo-utente>\projects\Personal Assistant\Personal Assistant

# Google OAuth (Fase 2 - Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Orario di invio del digest proattivo, formato HH:MM, fuso Europe/Rome (Fase 5).
# Alle 7:30 le newsletter TLDR del giorno non sono ancora arrivate (mostrerebbe
# solo quelle di ieri). Spostato dalle 14:00 alle 17:00 il 17/08/2026 per avere
# maggior margine: a volte anche alle 14:00 non erano ancora arrivate tutte.
MORNING_DIGEST_TIME=17:00

# Orario del promemoria mattutino sugli impegni (solo calendario, oggi + domani
# mattina presto), formato HH:MM, fuso Europe/Rome. Separato dal digest sopra
# perche' questo deve arrivare presto, mentre il digest e' rimandato per il TLDR.
EVENT_REMINDER_TIME=07:30

# Percorso del file "richiesta di refresh" osservato dal widget dei crediti
# Anthropic sul desktop (script separati in .claude/scripts/api-widget). Il bot
# gira in Session 0 (nessun desktop interattivo) e non puo' manipolare le
# finestre del widget direttamente: si limita a scrivere questo file, che
# overlay-widget.ps1 (in esecuzione nella sessione interattiva) osserva per
# lanciare il refresh vero e proprio.
CREDIT_WIDGET_TRIGGER_PATH=C:\Users\<tuo-utente>\.claude\scripts\api-widget\refresh-request.txt
