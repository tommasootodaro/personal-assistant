# Copia questo file in ".env" e riempi i valori reali.
# ".env" non va mai committato (è già in .gitignore).

# API key Anthropic (Claude)
ANTHROPIC_API_KEY=

# Percorso assoluto del vault Obsidian usato come knowledge base
OBSIDIAN_VAULT_PATH=C:\Users\tomma\projects\Personal Assistant\Personal Assistant

# Google OAuth (Fase 2 - Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Orario di invio del digest proattivo, formato HH:MM, fuso Europe/Rome (Fase 5).
# Alle 7:30 le newsletter TLDR del giorno non sono ancora arrivate (mostrerebbe
# solo quelle di ieri): spostato quindi al primo pomeriggio.
MORNING_DIGEST_TIME=14:00

# Orario del promemoria mattutino sugli impegni (solo calendario, oggi + domani
# mattina presto), formato HH:MM, fuso Europe/Rome. Separato dal digest sopra
# perche' questo deve arrivare presto, mentre il digest e' rimandato per il TLDR.
EVENT_REMINDER_TIME=07:30
